# zoeTrading local environment example
# Copy to .env locally and fill values. Never commit real secrets.

ZOETRADING_ENV=local
ZOETRADING_MODE=MONITORING
ZOETRADING_CONFIG_DIR=config
ZOETRADING_LOG_DIR=logs
ZOETRADING_DATA_DIR=data

# Optional MT5 settings for later tasks
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

